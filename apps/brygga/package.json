{
  "name": "brygga",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "node ../../scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@homelab/i18n": "*",
    "@homelab/server-kit": "*",
    "@homelab/ui": "*",
    "@hono/node-server": "^2.1.9",
    "better-sqlite3": "^13.2.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "tailwind-merge": "^3.7.0"
  }
}
