# Copy to .env for `npm run dev:garden` (API on :3500, Vite client on :4200 proxying /api/ to it).
PORT=3500
DATABASE_PATH=./data/app.db
# dev = auto-login as a fake user (never in production); oidc = real login
AUTH_MODE=dev
SESSION_SECRET=change-me-to-a-long-random-string
PUBLIC_URL=http://localhost:4200
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=garden
OIDC_CLIENT_SECRET=
