{
  "name": "garden",
  "version": "0.1.7",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "concurrently -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "node ../../scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@homelab/i18n": "*",
    "@homelab/server-kit": "*",
    "@homelab/ui": "*",
    "@hono/node-server": "^2.1.9",
    "better-sqlite3": "^13.2.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "exif-reader": "^2.0.3",
    "hono": "^4.13.19",
    "openid-client": "^6.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "rrule": "^2.8.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0"
  }
}
