PORT=3000
DATABASE_PATH=./data/app.db
# dev = auto-login as a fake user (never in production); oidc = real login
AUTH_MODE=dev
SESSION_SECRET=change-me-to-a-long-random-string
PUBLIC_URL=http://localhost:5173
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=fartlek
OIDC_CLIENT_SECRET=
# The Pocket ID user group that sees the developer settings (default admin). Dev mode is always admin.
# ADMIN_GROUP=admin
# Encrypts Garmin keys at rest. Required in production (>= 32 chars), or RUNPLAN_MASTER_KEY_FILE for a Docker secret.
RUNPLAN_MASTER_KEY=
# Demo mode: each visitor gets their own throwaway database file (max 100, deleted after 2 h idle).
# On by default outside production; set DEMO_ENABLED=true to turn it on in production.
DEMO_ENABLED=true
# Defaults to demo/ next to DATABASE_PATH; must not contain the real database.
# DEMO_DIR=./data/demo
