# Komodo's settings. Copy to compose.env next to compose.yaml (never commit it).
# Full list: https://github.com/moghtech/komodo/blob/main/compose/compose.env
COMPOSE_KOMODO_IMAGE_TAG="2"
COMPOSE_KOMODO_BACKUPS_PATH=/etc/komodo/backups
DOMAIN=didrik.dev
TZ=Europe/Stockholm

# Generate with: openssl rand -hex 32
KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD=
# Also set as the GitHub secret KOMODO_WEBHOOK_SECRET and on the repo's webhook.
KOMODO_WEBHOOK_SECRET=
KOMODO_JWT_SECRET=

KOMODO_HOST=https://komodo.didrik.dev
KOMODO_TITLE=Komodo · marvin
KOMODO_FIRST_SERVER_NAME=marvin
KOMODO_PERIPHERY_PUBLIC_KEY=file:/config/keys/periphery.pub

# Local login for the first admin. Once Pocket ID login works, set it to false; the admin
# password then only matters as a way back in if Pocket ID is down.
KOMODO_LOCAL_AUTH=true
KOMODO_INIT_ADMIN_USERNAME=didrik
KOMODO_INIT_ADMIN_PASSWORD=
KOMODO_DISABLE_USER_REGISTRATION=true
KOMODO_ENABLE_NEW_USERS=false # a new user (also via OIDC) waits for an admin to enable it

# Sign in with Pocket ID. Create an OIDC client named Komodo with callback
# https://komodo.didrik.dev/auth/oidc/callback, limited to a group with only you.
KOMODO_OIDC_ENABLED=false
# KOMODO_OIDC_PROVIDER=https://sso.didrik.dev
# KOMODO_OIDC_CLIENT_ID=
# KOMODO_OIDC_CLIENT_SECRET=
# KOMODO_DISABLE_USER_REGISTRATION above also blocks OIDC sign-ups. Allow them (false) for
# your first Pocket ID login, then set this back to true.
# KOMODO_DISABLE_OIDC_USER_REGISTRATION=false

KOMODO_MONITORING_INTERVAL="1-min" # light on a small board
KOMODO_RESOURCE_POLL_INTERVAL="1-hr"

# Periphery (runs on the same host, connects to Core over the compose network)
PERIPHERY_CORE_ADDRESS=ws://core:9120
PERIPHERY_CONNECT_AS=${KOMODO_FIRST_SERVER_NAME}
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub
PERIPHERY_ROOT_DIRECTORY=/etc/komodo
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
